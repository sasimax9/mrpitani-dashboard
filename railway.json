{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "PYTHONPATH=. gunicorn -w 4 -k uvicorn.workers.UvicornWorker -b 0.0.0.0:$PORT server:app",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5
  }
}
